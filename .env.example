# =============================================================================
#  Hiddenjem — шаблон конфигурации окружения
# =============================================================================
#  Использование:   cp .env.example .env   →   впишите HORIZON_NLP_OPENAI_API_KEY   →   make up
#
#  Правила:
#   * `.env` не коммитится (см. .gitignore). Здесь только шаблон.
#   * Значения ниже — рабочая конфигурация демонстрационного стенда: открытые источники включены,
#     языковая модель — gpt-5.6-luna через OpenAI-совместимый API. Пароли — dev-умолчания,
#     доступные только внутри docker-сети.
#   * Строки, помеченные `# [PROD:REQUIRED]`, в промышленной среде задаются через Secret/vault.
#   * Строки `# [PROD:OVERRIDE]` имеют dev-умолчание, которое нельзя переносить в прод.
#   * Источники, которым нужен ключ (alphaXiv, Lens), выключены или бездействуют, пока ключ не задан.
# =============================================================================

# ─────────────────────────────── 0. Общее ───────────────────────────────
COMPOSE_PROJECT_NAME=horizon
# Логическое имя среды: local | ci | dev | staging | prod. Попадает в OTel как deployment.environment.
HORIZON_ENV=local
# Версия сборки; проставляется CI (`git describe`). Локально — dev.
HORIZON_VERSION=dev
# Хеш коммита; попадает в OCI-лейблы образов и в бандл фронтенда.
HORIZON_REVISION=unknown
# Все временные метки в системе — UTC (NFR-D4). Менять не нужно.
TZ=UTC
# Тег образов, которые поднимает compose. `local` = собранные `make build`.
HORIZON_IMAGE_TAG=local
# Реестр образов (для release.yml и helm). Локально не используется.
HORIZON_IMAGE_REGISTRY=ghcr.io/horizon

# ─────────────────────────── 1. Порты, публикуемые на host ───────────────────────────
# Меняйте, если порт уже занят.
GATEWAY_PORT=8080
FRONTEND_PORT=3000
TRENDS_PORT=8082
INGESTION_PORT=8083
ANALYTICS_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ─────────────────────────────── 2. PostgreSQL ───────────────────────────────
# Один инстанс, схема и пользователь на сервис (ADR-0006, NFR-D1).
POSTGRES_HOST=postgres
POSTGRES_DB=horizon
# Bootstrap-суперпользователь: используется ТОЛЬКО контейнером postgres-init.
# Ни один сервис не подключается под ним.
POSTGRES_SUPERUSER=horizon_admin
# [PROD:REQUIRED]
POSTGRES_SUPERUSER_PASSWORD=horizon_admin_dev_pwd

# Роли приложений. Гранты — только на собственную схему.
INGESTION_DB_USER=ingestion_app
# [PROD:REQUIRED]
INGESTION_DB_PASSWORD=ingestion_dev_pwd
TRENDS_DB_USER=trends_app
# [PROD:REQUIRED]
TRENDS_DB_PASSWORD=trends_dev_pwd
ANALYTICS_DB_USER=analytics_app
# [PROD:REQUIRED]
ANALYTICS_DB_PASSWORD=analytics_dev_pwd

# Пул соединений (HikariCP). Суммарно по всем сервисам должно быть < max_connections postgres (100).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=3000

# ─────────────────────────── 3. Kafka / Redpanda (ADR-0005) ───────────────────────────
# Внутрикластерный адрес: слушатель `internal` Redpanda.
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# Внешний слушатель (с host-машины): localhost:19092.
KAFKA_EXTERNAL_BOOTSTRAP=localhost:19092
# Локально репликация всегда 1 — брокер один. В prod — 3.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
# Число попыток до отправки в `<topic>.dlq` (NFR-R4).
KAFKA_MAX_DELIVERY_ATTEMPTS=5
KAFKA_CONSUMER_GROUP_PREFIX=horizon

# ─────────────────────────────── 4. Redis (ADR-0011) ───────────────────────────────
REDIS_HOST=redis
# Пустая строка = без пароля. Локально безопасно: порт не публикуется наружу сети docker.
# [PROD:REQUIRED]
REDIS_PASSWORD=
REDIS_DATABASE=0
# Потолок памяти самого Redis. Должен быть заметно меньше REDIS_MEM_LIMIT:
# сверх датасета Redis тратит память на буферы клиентов и фрагментацию.
REDIS_MAXMEMORY=192mb
# TTL кэша готового отчёта (BR-A8).
HORIZON_REPORT_CACHE_TTL=PT24H

# ─────────────────────────── 5. ClickHouse (ADR-0007) ───────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DB=horizon
CLICKHOUSE_USER=horizon
# [PROD:REQUIRED]
CLICKHOUSE_PASSWORD=clickhouse_dev_pwd
# Где analytics-service хранит факты упоминаний: clickhouse | postgres.
# `postgres` — резервная реализация порта MentionFactStore; используется профилем `up-min`.
HORIZON_MENTION_STORE=clickhouse

# ─────────────────────────────── 6. Шлюз ───────────────────────────────
# CORS: явный allowlist, без `*` при credentials (NFR-S6).
#
# Стенд, открываемый не с localhost, обязан добавить сюда свой источник — целиком, со схемой и
# портом: `http://<хост>:3000` для интерфейса и `http://<хост>:8080`, если в шлюз ходят напрямую.
# Интерфейс проксирует /api на шлюз, но заголовок Origin браузера доезжает до него как есть,
# и незнакомый источник шлюз отвергает 403 с пустым телом. Видно это как «Недостаточно прав»
# на первом же запросе — сообщение, в котором про источник запроса нет ни слова.
# [PROD:OVERRIDE]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Rate limit (NFR-S7): token bucket в Redis, одно ведро на IP. Входа нет, поэтому и делить
# клиентов не на кого, кроме адреса. Ёмкость ведра — большее из минутной нормы и BURST.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=60
# Адреса upstream-сервисов для маршрутов шлюза.
HORIZON_UPSTREAM_TRENDS_URL=http://trends-service:8082
HORIZON_UPSTREAM_INGESTION_URL=http://ingestion-service:8083

# HSTS включаем только там, где есть TLS; локально по HTTP он бессмыслен и мешает.
# Таймаут проксирования SSE-потока прогресса (ADR-0012). Должен превышать NFR-P2 (90 с).

# ─────────────────────────── 7. Сбор данных (ingestion) ───────────────────────────
# ToS источников (NFR-S12): User-Agent обязан содержать контакт.
# Только имя и версия: контакт приписывает сам сервис из HORIZON_CONNECTOR_CONTACT_EMAIL.
# Адрес, вписанный сюда руками, попадал в заголовок вторым mailto — и мог не совпасть с первым.
HORIZON_INGESTION_USER_AGENT=HorizonBot/1.0
# Ящик, по которому источник может ответить. Crossref и OpenAlex пускают представившихся в
# «вежливый пул» и режут остальных, а умолчание здесь — заглушка на example.org: с ней прогон сбора
# через несколько часов начинает получать 429 и молча приносить ноль. Ранбук «Источник отвечает 429».
# [PROD:OVERRIDE]
HORIZON_CONNECTOR_CONTACT_EMAIL=ops@horizon.example
HORIZON_INGESTION_MAX_DOCUMENTS_PER_RUN=5000
HORIZON_INGESTION_HTTP_TIMEOUT=PT60S
# Circuit breaker на источники (resilience4j).
HORIZON_INGESTION_CB_FAILURE_RATE_THRESHOLD=50
HORIZON_INGESTION_CB_WAIT_DURATION=PT30S
# Включение коннекторов. Локально внешние источники выключены — они не дёргаются без явного
# согласия разработчика.
HORIZON_SOURCE_ARXIV_ENABLED=true
HORIZON_SOURCE_ALPHAXIV_ENABLED=false
HORIZON_ALPHAXIV_API_KEY=
HORIZON_SOURCE_OPENALEX_ENABLED=true
HORIZON_SOURCE_CROSSREF_ENABLED=true
HORIZON_SOURCE_GITHUB_ENABLED=true
# Источники из исследований к кейсу (разбор 89): второй научный указатель, биомедицина с
# аффилиациями, раннее внимание разработчиков, мировые новости. Ключ Semantic Scholar
# необязателен: без него анонимный пул и возможные 429.
HORIZON_SOURCE_SEMANTICSCHOLAR_ENABLED=true
HORIZON_SEMANTIC_SCHOLAR_API_KEY=
# The Lens — научные работы и патенты; ключ из подписки на API Lens. Патентный ключ, если он
# отдельный, — HORIZON_LENS_PATENT_API_TOKEN; иначе патенты берут общий.
HORIZON_SOURCE_LENS_ENABLED=true
HORIZON_LENS_API_TOKEN=
HORIZON_LENS_PATENT_API_TOKEN=
HORIZON_LENS_REQUESTS_PER_MINUTE=10
HORIZON_SOURCE_EUROPEPMC_ENABLED=true
HORIZON_SOURCE_HACKERNEWS_ENABLED=true
# GDELT отказывает с большинства адресов даже при паузе в полминуты между запросами; включать,
# только если с вашего адреса он отвечает.
HORIZON_SOURCE_GDELT_ENABLED=false
# Продуктовые и отраслевые источники (разбор 101): поиск Хабра (русские технические публикации и
# блоги компаний) и поисковые ленты шести отраслевых изданий — по одному на направление датасета.
# Ключей не требуют; оба проверяют robots.txt и держат паузу в десять секунд на хост.
HORIZON_SOURCE_HABR_ENABLED=true
HORIZON_SOURCE_INDUSTRY_ENABLED=true
HORIZON_SOURCE_USPTO_ENABLED=true
HORIZON_SOURCE_GLOBENEWSWIRE_ENABLED=true
HORIZON_SOURCE_PRNEWSWIRE_ENABLED=true
HORIZON_SOURCE_PRODUCTHUNT_ENABLED=true
HORIZON_SOURCE_EDGAR_ENABLED=true
HORIZON_SOURCE_IETF_ENABLED=true
HORIZON_SOURCE_SBIR_ENABLED=true
HORIZON_SOURCE_NSF_ENABLED=true
HORIZON_SOURCE_REGULATORS_ENABLED=true
# Глубокое исследование (разбор 102): агент на облачной модели (HORIZON_NLP_JUDGE_MODEL, например
# gpt-5.6-luna) ищет по открытым каталогам проекта — arXiv, Semantic Scholar, Crossref, Europe PMC,
# Hacker News, GitHub, Хабр, отраслевые издания; OpenAlex не спрашивает, — читает страницы целиком с
# соблюдением robots.txt и называет технологии ранней стадии. В корпус идут прочитанные страницы,
# подтвердившие имя, а не слова модели. Требует HORIZON_NLP_URL и HORIZON_NLP_GENERATIVE_BACKEND=openai.
# Бюджет — по режиму анализа из команды сбора. Остальные источники и узкие запросы идут
# параллельно и исследования не ждут: сбор длится примерно столько, сколько оно.
HORIZON_SOURCE_DEEPRESEARCH_ENABLED=true
# Собственный веб-корпус: каталог HORIZON_WEBCORPUS_DIR с signals.jsonl и docs.jsonl монтируется в
# сервис моделей. Архив — в релизе репозитория (см. README, «Веб-корпус»). Без файлов выключите
# источник, иначе каждый отчёт будет помечен неполным.
HORIZON_SOURCE_WEBCORPUS_ENABLED=true
HORIZON_WEBCORPUS_DIR=/opt/horizon-webcorpus
# Быстрый режим (весь анализ за 20 минут): шесть минут, агенту — 330 с.
HORIZON_DEEPRESEARCH_TIME_BUDGET=PT6M
HORIZON_DEEPRESEARCH_MAX_FETCHES=30
# Потолок ходов модели и минимум прочитанных страниц, о котором агенту говорит инструкция.
HORIZON_DEEPRESEARCH_MAX_ITERATIONS=40
HORIZON_DEEPRESEARCH_MIN_SOURCES=25
# Качественный режим (весь анализ за 40 минут): агенту — двадцать минут, втрое больше страниц.
# Потолки сервиса моделей (HORIZON_NLP_RESEARCH_*) обязаны быть не ниже этих чисел.
HORIZON_DEEPRESEARCH_QUALITY_TIME_BUDGET=PT20M30S
HORIZON_DEEPRESEARCH_QUALITY_MAX_ITERATIONS=120
HORIZON_DEEPRESEARCH_QUALITY_MAX_FETCHES=90
HORIZON_DEEPRESEARCH_QUALITY_MIN_SOURCES=40
# Список изданий — шаблоны поисковых лент в application.yml (`horizon.connectors.sources.industry.
# feeds`, переменная HORIZON_SOURCE_INDUSTRY_FEEDS): {q} — формулировка, {page} — страница. Пустая
# переменная не равна незаданной — она оставит источник без изданий, поэтому здесь её нет.
# Запасной корпус движка аналитики, когда HORIZON_INGESTION_URL не задан (ADR-0015).
HORIZON_FIXTURE_CORPUS_PATH=/opt/horizon/fixtures/corpus/documents.jsonl
# Ключи внешних API. Пустые = коннектор остаётся выключенным.
HORIZON_CONNECTOR_CONTACT_EMAIL=ops@horizon.example
# [PROD:REQUIRED] если коннектор включён
HORIZON_GITHUB_TOKEN=
# Объектное хранилище сырых ответов (NFR-D3, 90 дней). Локально — файловая заглушка.
HORIZON_RAW_STORE_PATH=/var/lib/horizon/raw

# ─────────────────────────── 8. Анализ (analytics-service) ───────────────────────────
# Роль процесса: api | worker. В compose задаётся аргументом entrypoint, здесь — умолчание.
HORIZON_ANALYTICS_ROLE=api
HORIZON_ANALYTICS_WORKER_CONCURRENCY=2
# Сколько анализ вправе держать команду без опроса очереди, мс. Умолчание aiokafka — пять минут,
# а анализ идёт пять–десять: брокер исключал бы потребителя посреди анализа. 45 минут — выше саги
# качественного режима.
HORIZON_ANALYTICS_MAX_POLL_INTERVAL_MS=2700000
# Провайдер эмбеддингов (ADR-0009): tfidf-svd детерминирован и не требует GPU.
# [PROD:OVERRIDE] опц.: sentence-transformers
HORIZON_EMBEDDING_PROVIDER=tfidf-svd
HORIZON_EMBEDDING_DIM=384
# Нарратив (ADR-0010): extractive | llm. LLM — за feature-flag.
HORIZON_NARRATIVE_MODE=extractive
HORIZON_LLM_ENABLED=false

# ── Движок внешних признаков (signals) ───────────────────────────────────────────────
# Движок один — `signals`, и он не настраивается: прежняя HORIZON_ENGINE больше не читается.
#
# Путь к артефакту обученной модели: список признаков, веса, сдвиг, нормировка, версия, дата
# обучения и метрика на отложенной части (см. docs/technical.md, «Модель внешних признаков»).
#
# Пусто — модель, поставляемая с пакетом (resources/signals-model.json); какой
# артефакт выбран, пишется в журнал при старте. Заданный путь важнее; путь к файлу, которого нет, —
# отказ анализа с названной причиной, а не откат к поставляемой модели.
HORIZON_SIGNALS_MODEL=
# Кэш собранных внешних признаков: один каталог на развёртывание, второй анализ того же
# направления не платит за сбор ничего. Пусто — /opt/horizon/signals/cache внутри контейнера, то
# есть подкаталог HORIZON_SIGNALS_PATH на хосте; он должен принадлежать пользователю 10001.
HORIZON_SIGNALS_CACHE_DIR=
# Каталог хоста, который монтируется в анализ как /opt/horizon/signals (кэш и свой артефакт модели).
HORIZON_SIGNALS_PATH=/opt/horizon-signals
# Скольких кандидатов спрашивать у внешних источников. Полторы сотни — это минута-две по быстрым
# источникам и весь верх ранжирования; остальные считаются по корпусной части с пометкой.
HORIZON_SIGNALS_TOP_CANDIDATES=150
# Не ходить в сеть вообще: признаки берутся только из кэша, несобранное честно отмечается
# отказом. Режим воспроизводимого прогона — те же числа при нулевом трафике.
HORIZON_SIGNALS_CACHE_ONLY=false
# Потолки времени на опрос внешних источников: на весь этап и на один термин у одного источника.
#
# Не «на всякий случай». Анализ обязан закончиться, а чужой сервер ничего нам не обещал: источник,
# который отвечает по сорок пять секунд и трижды просит повторить, растягивает полторы сотни
# кандидатов на часы, и снаружи это неотличимо от зависания. Кандидаты, до которых не дошла
# очередь, считаются по корпусной части и помечены — ровно как те, о ком источник промолчал.
HORIZON_SIGNALS_BUDGET_SECONDS=300
HORIZON_SIGNALS_TERM_BUDGET_SECONDS=30
# Второй источник кандидатов: просить ли у генеративной модели имена технологий направления
# сверх тех, что извлеклись из корпуса. Требует HORIZON_NLP_URL.
#
# Зачем. Извлечение достаёт кандидатов только из собранного корпуса, и у этого пути измерен
# потолок: из ста технологий размеченного эталона у 82 фраза не встречается в корпусе ни разу, а
# шестнадцать из них OpenAlex знает сотнями работ. Их не «плохо отранжировали» — их не спросили.
#
# Граница ТЗ §3.1 («выдача не формируется исключительно на основании знаний языковой модели»)
# проходит не здесь, а в движке: предложенное имя попадает в отчёт только после того, как внешние
# источники показали по нему измеренную активность и дали хотя бы одну настоящую работу в
# доказательную базу. Неподтверждённые имена уходят в перечень исключённого с этой причиной.
#
# Выключено по умолчанию: умолчание стенда не должно меняться само вместе с новой возможностью.
HORIZON_SIGNALS_PROPOSE_CANDIDATES=true
HORIZON_SIGNALS_PROPOSED_LIMIT=80

# Откуда аналитический движок берёт собранный корпус (ADR-0006: сервис не читает чужую базу).
# Пустой адрес означает «работать по эталонному корпусу» — законный режим демонстрации без базы,
# но именно режим, а не запасной путь: эталонный корпус отвечает на любой идентификатор снапшота
# и потому способен незаметно подменить собой настоящие данные.
HORIZON_INGESTION_URL=http://ingestion-service:8083
HORIZON_INGESTION_CORPUS_PAGE_SIZE=500

# ── Сервис вывода моделей (ADR-0017) ────────────────────────────────────────────────
# Пустой адрес выключает и семантический фильтр кандидатов, и русский слой выдачи: движок ведёт
# себя ровно так, как вёл до их появления, и остаётся побайтово воспроизводимым. Это законный
# режим, а не деградация — на нём стоят golden-тесты.
#
# Перед первым включением скачайте веса: `make models`. Без них контейнер `llm` поднимется, но
# ответит «модель не найдена», а сервис вернёт «не знаю» — то есть выдача будет как без него.
# [PROD:OVERRIDE] стенд: http://horizon-nlp:8086
HORIZON_NLP_URL=http://horizon-nlp:8086
HORIZON_NLP_JUDGE_MODEL=gpt-5.6-luna
HORIZON_NLP_JUDGE_ENABLED=true
HORIZON_NLP_LOCALIZATION_ENABLED=true
# Модель считает процессором: тридцать кандидатов — около минуты, перевод пятнадцати названий —
# около двадцати секунд. Таймаут с запасом на очередь, но заметно меньше дедлайна саги: зависшая
# модель обязана стоить отчёту русского слоя, а не самого отчёта.
HORIZON_NLP_TIMEOUT_SECONDS=240

# Бэкенд генеративной модели: ollama (локально) или openai (облачный API в формате OpenAI из
# перечня ТЗ, например gpt-5.6-luna). Для openai имя модели — в HORIZON_NLP_JUDGE_MODEL.
HORIZON_NLP_GENERATIVE_BACKEND=openai
HORIZON_NLP_OPENAI_BASE_URL=https://api.aiproductiv.ru/v1
HORIZON_NLP_OPENAI_API_KEY=
HORIZON_NLP_OPENAI_REASONING_EFFORT=low
# Потолки глубокого исследования на стороне сервиса моделей. Это не бюджет: бюджет прогона
# приходит в запросе сервиса сбора по режиму анализа. Потолки обязаны покрывать качественный
# режим — 20 минут агенту (1200 с), 120 ходов, 90 страниц.
HORIZON_NLP_RESEARCH_TIME_BUDGET_SECONDS=1260
HORIZON_NLP_RESEARCH_MAX_ITERATIONS=120
HORIZON_NLP_RESEARCH_MAX_FETCHES=100

# Расширение запроса перед сбором: модель предлагает узкие формулировки подтем направления, и
# каждая уходит в источники отдельным запросом (разбор 91). Требует HORIZON_NLP_URL.
# [PROD:OVERRIDE] стенд: true
HORIZON_QUERY_EXPANSION_ENABLED=true
# Глубина: документов на пару «формулировка × источник» и резерв узких запросов сверх бюджета
# запроса направления (0 — доля 0,4 из общего бюджета). Корпус растёт на резерв — поднимите и
# maxDocumentsAnalyzed профиля, иначе анализ усечёт как раз собранное последним.
# [PROD:OVERRIDE] стенд: 80 и 6720
HORIZON_QUERY_EXPANSION_PER_QUERY_DOCUMENTS=80
HORIZON_QUERY_EXPANSION_RESERVE_DOCUMENTS=10560
# Языки узких запросов через запятую: en всегда, ru и zh по желанию. Русские и китайские уходят
# только в каталоги, которые на них ищут (OpenAlex, Crossref).
# [PROD:OVERRIDE] стенд: en,ru,zh
HORIZON_QUERY_EXPANSION_LANGUAGES=en,ru,zh
# Сколько подтем просить у модели и какую долю бюджета документов отдать узким запросам.
HORIZON_QUERY_EXPANSION_MAX_QUERIES=12
HORIZON_QUERY_EXPANSION_BUDGET_SHARE=0.4
# Перевод русских и китайских документов на английский после сбора генеративной моделью; перевод
# хранится с документом. Требует HORIZON_NLP_URL.
# [PROD:OVERRIDE] стенд: true
HORIZON_TRANSLATION_ENABLED=true
HORIZON_TRANSLATION_CONCURRENCY=12
HORIZON_TRANSLATION_TIME_BUDGET=PT4M
HORIZON_TRANSLATION_BATCH_SIZE=20
# Четыре минуты на пачку: китайские аннотации модель переводит дольше русских.
HORIZON_TRANSLATION_TIMEOUT=PT240S
# Потолок времени узких запросов в сборе.
HORIZON_QUERY_EXPANSION_TIME_BUDGET=PT6M

# Внешняя проверка зрелости тем верхушки по OpenAlex и английской Википедии — то же правило
# мейнстрима, которым измерена точность на размеченном датасете. Выключена по умолчанию: анализ
# не должен ходить в чужие сервисы, пока его об этом явно не попросили. Бюджет — секунды на один
# анализ; непроверенные к его концу темы остаются в отчёте.
HORIZON_EXTERNAL_MATURITY_ENABLED=true
HORIZON_EXTERNAL_MATURITY_BUDGET_SECONDS=120

# Ключ OpenAlex (бесплатная регистрация на openalex.org). Без него суточный бюджет — $0,10 на
# адрес, сто поисковых запросов: хватает на полтора десятка сборов, если больше ничто OpenAlex не
# спрашивает. С ключом — $1 в сутки, и проверка зрелости добавляет правило числа работ.
HORIZON_OPENALEX_API_KEY=
# Дополнительные BYOK-ключи в порядке использования, через запятую. При HTTP 429 клиент
# переходит к следующему ключу; на следующие сутки (UTC) начинает с первого.
HORIZON_OPENALEX_API_KEYS=
# Куда скачаны веса. Тот же каталог монтируется и в `llm`, и в `nlp-service`.
HORIZON_MODELS_PATH=/opt/horizon-models
LLM_PORT=11434
NLP_PORT=8086
# Методология: фиксируется в отчёте (BRULE-5, ADR-0015).
# Дедлайн саги (NFR-P2: p95 <= 90 с). Планировщик переводит просроченные в FAILED/SAGA_TIMEOUT.
# Режим анализа выбирает дедлайн: быстрый — двадцать минут, качественный — сорок (глубокое
# исследование в нём читает двадцать).
# Предохранитель от зависшего анализа, а не срок качества: отчёт на 23-й минуте лучше, чем отказ
# на 20-й (29.09). Быстрый режим обычно укладывается в 11–15 минут.
HORIZON_SAGA_TIMEOUT=PT60M
HORIZON_SAGA_TIMEOUT_QUALITY=PT90M
HORIZON_SAGA_TIMEOUT_SCAN_INTERVAL=PT30S
# Инъекция времени для детерминированного QA (ADR-0015). Пусто = системные часы.

# ─────────────────────────── 9. Наблюдаемость (NFR-O1..O5) ───────────────────────────
# Требование: у КАЖДОГО сервиса задан OTLP-эндпоинт, имя и ресурсные атрибуты.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Доля трассируемых запросов. Локально 1.0; в prod — 0.1 и хвостовая выборка в коллекторе.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# [PROD:OVERRIDE] prod: 0.1
OTEL_TRACES_SAMPLER_ARG=1.0
# Уровень логирования; формат — JSON с traceId (NFR-O3).
HORIZON_LOG_LEVEL=INFO
HORIZON_LOG_FORMAT=json
# Grafana: только локальный доступ; в prod — за SSO.
GRAFANA_ADMIN_USER=admin
# [PROD:REQUIRED]
GRAFANA_ADMIN_PASSWORD=admin
# Хранение метрик в локальном Prometheus.
PROMETHEUS_RETENTION=72h

# ─────────────────────────── 10. Ограничения ресурсов ───────────────────────────
# Соответствуют бюджету NFR §9. Профиль `up-min` (make up-min) переопределяет их вниз.
GATEWAY_MEM_LIMIT=512m
TRENDS_MEM_LIMIT=1g
INGESTION_MEM_LIMIT=1g
ANALYTICS_API_MEM_LIMIT=8g
ANALYTICS_WORKER_MEM_LIMIT=16g
FRONTEND_MEM_LIMIT=128m
POSTGRES_MEM_LIMIT=1g
# Лимит контейнера redpanda.
REDPANDA_MEM_LIMIT=1g
# Память самого seastar. Обязана быть МЕНЬШЕ лимита контейнера: seastar требует столько
# доступной памяти, а cgroup оставляет её чуть меньше объявленного лимита — при равенстве
# он не стартует («insufficient physical memory: needed 1073741824 available 1004535808»).
# Заглавная буква единицы обязательна: строчную «g» seastar не разбирает.
REDPANDA_SEASTAR_MEM=768M
REDIS_MEM_LIMIT=256m
CLICKHOUSE_MEM_LIMIT=1g

# ─────────────────────────── 11. Только для CI/CD ───────────────────────────
# Не нужны для локального запуска; перечислены, чтобы список переменных был полным.
# GITHUB_TOKEN=                                      # выдаётся Actions автоматически
# GHCR_USERNAME=                                     # [PROD:REQUIRED] публикация образов
# KUBE_CONFIG_STAGING=                               # [PROD:REQUIRED] base64 kubeconfig, GitHub Secret
# KUBE_CONFIG_PRODUCTION=                            # [PROD:REQUIRED] base64 kubeconfig, GitHub Secret
# GITLEAKS_LICENSE=                                  # только для gitleaks в организации

# ─────────── 12. Настройки служб с умолчаниями (перечислены, чтобы список был полным) ───────────
# Заполняются редко: умолчание рабочее. Здесь они потому, что настройка, о которой знает
# только код, не настраивается — `tools/check-env-wiring.py` сверяет этот список с тем,
# что службы читают, в обе стороны.

# gateway
RATE_LIMIT_ENABLED=true

# JVM-службы (trends-service, ingestion-service)
# Профили Spring для compose-стенда: `local` включает application-local.yml служб.
SPRING_PROFILES_ACTIVE=docker,local

# trends-service
HORIZON_ANALYTICS_BASE_URL=http://analytics-service:8000
# Общий секрет trends↔analytics.
#
# Пустое значение — не «без пароля», а «внутренние маршруты выключены»: движок отвечает на них 404.
# Выключаются при этом не отладочные мелочи, а две вещи, которые аналитик видит:
#   • подсказка «какие направления система распознаёт» на пустом поле ввода;
#   • перевод направления в предметные коды корпуса перед сбором — без него русская формулировка не
#     находит ни одного документа, и анализ заканчивается отказом за секунду.
# Именно так стенд и работал: секрет пуст, коды не запрашивались, «искусственный интеллект» падал.
#
# Значение любое случайное, лишь бы совпадало у обоих сервисов: `openssl rand -hex 32`.
# [PROD:REQUIRED]
HORIZON_ANALYTICS_INTERNAL_SECRET=
HORIZON_ANALYTICS_TIMEOUT=PT300S
# Трассировка термина: повтор анализа плюс очередь к движку; ждёт фоновый поток, не браузер.
HORIZON_ANALYTICS_EXPLAIN_TIMEOUT=PT20M
HORIZON_GROUP_ANALYSIS_EVENTS=trends-service.analysis-events.v1
HORIZON_GROUP_INGESTION_EVENTS=trends-service.ingestion-events.v1
HORIZON_KAFKA_CONCURRENCY=2
HORIZON_MAX_DOCUMENTS=5000
HORIZON_ORG_QUOTA_PER_HOUR=200
HORIZON_OUTBOX_BATCH_SIZE=100
HORIZON_OUTBOX_MAX_ATTEMPTS=25
HORIZON_OUTBOX_POLL_INTERVAL=PT0.2S
HORIZON_OUTBOX_RETENTION=P7D
HORIZON_RESULT_TTL=PT24H
HORIZON_SSE_HEARTBEAT_MS=15000
HORIZON_SSE_REDIS_FANOUT=true
HORIZON_SSE_TIMEOUT_MS=600000
HORIZON_TIMEOUT_SWEEP_BATCH=100
HORIZON_USER_QUOTA_PER_HOUR=20

# ingestion-service
DB_PASSWORD=ingestion_app
DB_POOL_SIZE=10
DB_URL=jdbc:postgresql://localhost:5432/horizon
DB_USERNAME=ingestion_app
# Лент по умолчанию не настроено, поэтому включённый rss не может отдать ни одного документа —
# зато попадает в перечень недоступных источников, и каждый отчёт выходит с оговоркой «корпус
# собран не полностью». Оговорка при этом верна: источник включили и не настроили. Значение
# приведено в соответствие с остальными внешними источниками — включать вместе с лентами
# (`horizon.connectors.sources.rss.feeds`).
HORIZON_SOURCE_RSS_ENABLED=false
# Ленты через запятую. Без них включённый rss не отдаёт ни одного документа и попадает в перечень
# недоступных источников — то есть портит каждый отчёт, ничего не давая взамен.
#
# Две ловушки, из-за которых лента молча даёт ноль документов и выглядит настроенной:
#   • robots.txt хозяина. `export.arxiv.org` запрещает обход целиком (`Disallow: /`), и его ленты
#     сборщик пропускает — правильно пропускает, но снаружи это неотличимо от «новостей нет».
#     Заодно они и не нужны: arXiv уже собирается собственным коннектором.
#   • переадресация. `spectrum.ieee.org/rss/fulltext` отвечает 301, а клиент за переадресацией не
#     ходит: адрес нужен конечный (`/feeds/feed.rss`).
#
# Ленты по умолчанию нет. Прежний список (IEEE Spectrum, MIT Technology Review, Ars Technica,
# Nature) снят 2026-09-27: robots.txt всех четырёх поимённо закрывает сайт ИИ-краулерам.
# Сборщик представляется HorizonBot и формально под запрет
# не попадает, но проект держится правила «поимённый запрет — отказ, а не препятствие». Отраслевые
# новости теперь собирает коннектор industry (разбор 101), и там площадки отобраны по этому правилу.
HORIZON_SOURCE_RSS_FEEDS=
INGESTION_LOCK_ENABLED=true
INGESTION_PAGE_SIZE=100
INGESTION_SCHEDULE_ENABLED=false

# analytics-service
ANALYTICS_DB_SCHEMA=analytics
CLICKHOUSE_DATABASE=horizon
CLICKHOUSE_URL=http://clickhouse:8123
HORIZON_ANALYSIS_COMMANDS_TOPIC=horizon.analysis.commands.v1
HORIZON_ANALYSIS_EVENTS_TOPIC=horizon.analysis.events.v1
HORIZON_ANALYTICS_HOST=0.0.0.0
HORIZON_ANALYTICS_PORT=8000
# Порт метрик роли worker: у неё нет HTTP-API, а стадии конвейера считает именно она
HORIZON_METRICS_PORT=9100
HORIZON_EMBEDDING_MODEL_PATH=
HORIZON_EMBEDDING_SEED=20260805
HORIZON_EMBEDDING_URL=
HORIZON_FIXED_CLOCK=
HORIZON_METHODOLOGY_VERSION=1.0.0
HORIZON_WORKER_LIVENESS_FILE=/tmp/worker-alive
