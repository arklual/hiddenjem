<?xml version="1.0" encoding="UTF-8"?>
<!--
  Подавления OWASP Dependency-Check.

  Файл пуст намеренно и при этом обязан существовать: конвейер передаёт его параметром
  `suppression`, и без файла шаг падает на разборе («Failed to load .dependency-check-suppressions.xml»),
  то есть проверка зависимостей не выполняется вовсе. Отличить это от «уязвимостей не найдено» по
  цвету значка нельзя, а до первого запуска конвейера этого никто не видел.

  Как добавлять подавление: элемент `suppress` с атрибутом `until` и вложенным `notes`, где сказано,
  почему принято и кем. Правило то же, что у .trivyignore: у исключения обязаны быть причина и дата
  пересмотра. Понижать порог `failOnCVSS` вместо записи сюда нельзя: так пропадает не уязвимость, а
  знание о ней.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
