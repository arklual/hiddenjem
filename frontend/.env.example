# ─────────────────────────────────────────────────────────────────────────────
# Horizon frontend — build-time configuration
#
# Copy to `.env.local` and adjust. Only variables prefixed `VITE_` reach the
# browser bundle, and everything here is PUBLIC: it is inlined into the shipped
# JavaScript at build time. Never put a secret, token or API key in this file.
#
# There is no authentication: a single organization and an open API, so there
# is nothing to configure for sign-in.
# ─────────────────────────────────────────────────────────────────────────────

# Origin the API is served from.
# Leave EMPTY in both dev and prod — the Vite dev server and the production
# nginx both proxy `/api` to the gateway, so requests stay same-origin without
# any CORS complications.
# Set this only for a deployment where the API genuinely lives on another origin
# (which then also requires CORS on the gateway).
VITE_API_BASE_URL=

# Dev-only: where `vite.config.ts` proxies `/api` to. Read by the config file,
# never by application code.
VITE_API_PROXY_TARGET=http://localhost:8080

# Polling cadence (ms) for the progress fallback when SSE is unavailable.
# ADR-0012 sizes this at 2 s.
VITE_PROGRESS_POLL_INTERVAL_MS=2000

# How long (ms) the SSE stream may stay silent before it is judged dead and the
# client degrades to polling. Must exceed the server's 15 s heartbeat interval
# with margin for a slow hop — 40 s tolerates two missed heartbeats.
VITE_SSE_STALE_TIMEOUT_MS=40000
