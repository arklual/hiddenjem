<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>dev.horizon</groupId>
  <artifactId>horizon-services</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Horizon :: services</name>
  <description>Платформа обнаружения зарождающихся научно-технологических трендов</description>

  <modules>
    <module>platform/platform-common</module>
    <module>platform/platform-spring</module>
    <module>ingestion-service</module>
    <module>trends-service</module>
    <module>gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <springdoc.version>2.6.0</springdoc.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <archunit.version>1.3.0</archunit.version>
    <wiremock.version>3.9.1</wiremock.version>
    <!-- 1.78.1 → 1.84: CVE-2025-14813 (CRITICAL). Обновление в пределах ветки, API не менялся. -->
    <bouncycastle.version>1.84</bouncycastle.version>
    <!-- Драйвер Postgres приходит из BOM Spring Boot версией 42.7.4, в которой три уязвимости:
         CVE-2025-49146 (HIGH, небезопасная аутентификация), CVE-2026-42198 и CVE-2026-54291.
         Свойство с этим именем BOM и переопределяет — версия поднята здесь, а не подменена
         зависимостью, чтобы её видели все модули разом. -->
    <postgresql.version>42.7.12</postgresql.version>
    <swagger-request-validator.version>2.43.0</swagger-request-validator.version>
    <jacoco.version>0.8.12</jacoco.version>
    <pitest.version>1.16.3</pitest.version>
    <pitest-junit5.version>1.2.1</pitest-junit5.version>
    <spotless.version>2.43.0</spotless.version>
    <!-- Закреплено явно: без версии palantir-java-format резолвится по последней доступной,
         и релиз форматтера делает `spotless:check` красным на неизменённом коде. -->
    <palantir-java-format.version>2.39.0</palantir-java-format.version>

    <!-- Пороги покрытия; доменные модули переопределяют вверх -->
    <jacoco.line.coverage>0.60</jacoco.line.coverage>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>platform-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>platform-spring</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.atlassian.oai</groupId>
        <artifactId>swagger-request-validator-core</artifactId>
        <version>${swagger-request-validator.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.atlassian.oai</groupId>
        <artifactId>swagger-request-validator-mockmvc</artifactId>
        <version>${swagger-request-validator.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Общий тестовый набор для всех модулей -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Пирамида тестирования: по умолчанию исполняются только быстрые тесты.
                 Медленные помечены @Tag("integration"|"e2e") и запускаются профилями. -->
            <excludedGroups>integration,e2e,slow</excludedGroups>
            <argLine>@{argLine} -Xmx512m -Duser.timezone=UTC -Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <groups>integration</groups>
            <argLine>@{argLine} -Xmx1g -Duser.timezone=UTC</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals><goal>report</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <targetClasses><param>dev.horizon.*.domain.*</param></targetClasses>
            <targetTests><param>dev.horizon.*</param></targetTests>
            <!--
              Тесты адаптеров подняты на Testcontainers: им нужны настоящие Postgres и брокер. Для
              мутаций доменного слоя они бесполезны — доменную мутацию убивает доменный тест, — а
              стоят дорого: PIT перезапускает набор на каждую мутацию, то есть поднимал бы
              контейнеры сотни раз. Здесь они только замедляют и добавляют поводов упасть.
            -->
            <excludedTestClasses><param>dev.horizon.*.adapter.*</param></excludedTestClasses>
            <mutationThreshold>70</mutationThreshold>
            <timestampedReports>false</timestampedReports>
            <!--
              Доменный слой есть не в каждом модуле: у platform-common и platform-spring его нет по
              устройству — это общая обвязка, а не предметная область. PIT в таком модуле по
              умолчанию считает отсутствие мутаций ошибкой сборки («No mutations found»), и весь
              ночной прогон валился на втором модуле из семи. То есть мутационное тестирование не
              выполнялось нигде: ни один сервис до него не доходил.

              Порог при этом не ослаблен: там, где доменные классы есть, mutationThreshold
              по-прежнему требует 70%. Пустой модуль просто перестаёт быть отказом.
            -->
            <failWhenNoMutations>false</failWhenNoMutations>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
              </palantirJavaFormat>
              <removeUnusedImports/>
              <importOrder><order>java,javax,jakarta,org,com,dev.horizon,</order></importOrder>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn verify -Pintegration : поднимает Testcontainers -->
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
