{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon.dev/schemas/document-ingested.event.json",
  "title": "DocumentIngested",
  "description": "Каноническое представление документа — единственный формат, который видит анализ (ACL завершён)",
  "type": "object",
  "required": ["documentId", "sourceId", "sourceClass", "externalId", "title", "publishedOn", "url", "fetchedAt"],
  "additionalProperties": false,
  "properties": {
    "documentId":   { "type": "string", "format": "uuid" },
    "sourceId":     { "type": "string", "maxLength": 48 },
    "sourceClass":  { "enum": ["PREPRINT","JOURNAL_ARTICLE","PATENT","CODE_REPOSITORY","NEWS","ANALYST_REPORT","STANDARD"] },
    "externalId":   { "type": "string", "maxLength": 200 },
    "title":        { "type": "string" },
    "abstractText": { "type": ["string", "null"] },
    "language":     { "type": ["string", "null"], "maxLength": 2 },
    "publishedOn":  { "type": "string", "format": "date" },
    "doi":          { "type": ["string", "null"] },
    "arxivId":      { "type": ["string", "null"] },
    "patentNumber": { "type": ["string", "null"] },
    "url":          { "type": "string" },
    "venue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": ["string", "null"] },
        "issn": { "type": ["string", "null"] }
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fullName"],
        "additionalProperties": false,
        "properties": {
          "fullName":           { "type": "string" },
          "orcid":              { "type": ["string", "null"] },
          "organizationName":   { "type": ["string", "null"] },
          "organizationType":   { "type": ["string", "null"],
                                  "enum": ["COMPANY","UNIVERSITY","RESEARCH_INSTITUTE","GOVERNMENT","NONPROFIT", null] },
          "organizationCountry":{ "type": ["string", "null"], "maxLength": 2 }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "additionalProperties": false,
        "properties": {
          "code":  { "type": "string" },
          "label": { "type": ["string", "null"] },
          "score": { "type": ["number", "null"] }
        }
      }
    },
    "citationCount": { "type": ["integer", "null"] },
    "extraMetrics":  { "type": "object" },
    "dedupKey":      { "type": "string" },
    "fetchedAt":     { "type": "string", "format": "date-time" }
  }
}
